{
  "name": "@pyreload/website",
  "version": "1.0.0",
  "description": "Marketing website for Pyreload Python file monitor",
  "private": true,
  "scripts": {
    "dev": "bun run assets && next dev -p 3014",
    "build": "bun run assets && next build && bun ../scripts/legacy-redirects.ts",
    "preview": "python3 ../scripts/preview.py",
    "typecheck": "tsc --noEmit",
    "assets": "bun ../scripts/site-assets.ts",
    "audit": "bun audit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "highlight.js": "11.12.0",
    "lucide-react": "0.562.0",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/markdown-it": "14.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "22.x"
  }
}
