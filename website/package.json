{
  "name": "@pyreload/website",
  "version": "1.0.0",
  "description": "Marketing website for Pyreload Python file monitor",
  "private": true,
  "scripts": {
    "dev": "bun run assets && next dev -p 3014",
    "build": "bun run assets && next build && bun ../scripts/legacy-redirects.ts",
    "preview": "python3 ../scripts/preview.py",
    "typecheck": "tsc --noEmit",
    "assets": "bun ../scripts/site-assets.ts"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "lucide-react": "0.562.0",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/markdown-it": "14.1.2",
    "typescript": "5.9.3",
    "sharp": "0.34.5"
  }
}
