{
  "name": "pyreload-checks",
  "private": true,
  "scripts": {
    "markdown": "node scripts/check-markdown.mjs",
    "diagrams": "node scripts/check-diagrams.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "diagrams:update": "node scripts/check-diagrams.mjs --write",
    "audit": "bun audit && bun run --cwd website audit"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "prettier": "3.9.10",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "puppeteer": "25.14.0",
    "markdownlint": "0.41.1"
  },
  "overrides": {
    "katex": "0.18.11"
  }
}
